#!/usr/bin/env sh

# 推送前跑静态快检（lint / typecheck / 架构检查 / 两条漏接线护栏），先把低成本问题拦住。
#
# 全量单测**不在这里跑**：原先钩子跑 `pnpm verify:pre-push`，最后一步 `test:unit:affected`
# 只要发现推送范围里有被删除的代码文件就会退回全量单测（本机约 13.5 分钟），而删除文件正是
# 「去遥测」这类改造的常规操作。现在全量由 CI 承担（.github/workflows/ci.yml），本地只留
# 秒级到两分钟的静态检查。
#
# 因此这里不再需要读 git 从 stdin 传入的 push ref（那是 affected-test 脚本用来算 base 的）。
# 若以后要在钩子里恢复 `pnpm run verify:pre-push`，记得把 stdin 缓存一并加回来。

# Bugfix: Git hook 会注入 GIT_DIR/GIT_WORK_TREE 等 local env。
# 不清理会让检查里调用的 git 命令（架构检查的 changedFiles、护栏的 ls-files/grep）跑偏。
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
# 修复原因：强制 mise 会阻止已用其他方式准备好 Node/pnpm 的开发者推送；沿用当前环境。
pnpm run verify:static
